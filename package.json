{
  "name": "aios-desktop",
  "version": "0.10.1",
  "private": true,
  "description": "AIOS Desktop Command Center",
  "author": {
    "name": "AIOS",
    "email": "noreply@aios.app"
  },
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:3100 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3100 electron .\"",
    "build": "tsc -p tsconfig.main.json && node scripts/copy-main-assets.cjs && tsc -p tsconfig.renderer.json && vite build",
    "start": "electron dist/main/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:python": "node scripts/run-python-tests.js",
    "test:bundle": "node scripts/run-bundle-smoke-test.js",
    "check": "npm run build && npm run test && npm run test:python",
    "build:python": "pyinstaller --noconfirm --clean build/aios-host.spec",
    "pack": "npm run build && npm run build:python && electron-builder --dir",
    "dist": "npm run build && npm run build:python && electron-builder",
    "dist:win": "npm run build && npm run build:python && electron-builder --win",
    "dist:mac": "npm run build && npm run build:python && electron-builder --mac",
    "release": "npm run build && npm run build:python && electron-builder --publish always",
    "release:no-python": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "@xyflow/react": "^12.10.2",
    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "lucide-react": "^0.561.0",
    "pino": "^9.5.0",
    "posthog-js": "^1.376.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.aios.desktop",
    "productName": "AIOS Desktop",
    "copyright": "Copyright © 2026 AIOS",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "compression": "normal",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "assets/icon.png",
      "!**/*.{md,map,ts,tsx,scss,test.js,spec.js}",
      "!**/{__pycache__,.pytest_cache,.cache,.tmp,test,tests,spec,specs}",
      "!**/*.{ico,icns,svg,jpg,jpeg}",
      "!.git",
      "!.edge-profile",
      "!supabase",
      "!aios-starter-kit/.git",
      "!python/__pycache__",
      "!python/tests"
    ],
    "extraResources": [
      {
        "from": "dist/aios-host",
        "to": "aios-host",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "aios-starter-kit",
        "to": "aios-starter-kit",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/keytar/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AIOS uses your microphone for voice input in Computer Control.",
        "NSScreenCaptureUsageDescription": "AIOS captures your screen so Computer Control can see what's on screen and act on your voice commands.",
        "NSAppleEventsUsageDescription": "AIOS uses Apple Events to bring the launched app to the foreground after you say 'open <app>' — so the next screenshot reflects the app you asked for.",
        "NSDocumentsFolderUsageDescription": "AIOS reads folders you attach in chat so Claude can help you with their contents.",
        "NSDesktopFolderUsageDescription": "AIOS reads folders you attach in chat so Claude can help you with their contents.",
        "NSDownloadsFolderUsageDescription": "AIOS reads folders you attach in chat so Claude can help you with their contents.",
        "NSRemovableVolumesUsageDescription": "AIOS reads folders you attach from external drives so Claude can help you with their contents.",
        "NSNetworkVolumesUsageDescription": "AIOS reads folders you attach from network drives so Claude can help you with their contents.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.png",
      "sign": true,
      "writeUpdateInfo": true
    },
    "afterAllArtifactBuild": "build/notarize-dmg.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIOS Desktop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "publish": {
      "provider": "github",
      "owner": "everyai-com",
      "repo": "AIOS_Desktop",
      "releaseType": "release"
    }
  }
}
